{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "ES2020", "ES2022.Error"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["nodes/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
